@page "/categories"
<PageTitle>Categorias</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck"/> Categorias
        <HxButton CssClass="float-end" Text="Nueva Categoria" Color="ThemeColor.Primary" Size="ButtonSize.Small" Icon="BootstrapIcon.PlusSquare" IconPlacement="ButtonIconPlacement.Start" OnClick="@(() => ShowModalAsync())" />
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar categoria..." Callback="@FilterCallBack" />
        <GenericList MyList="Categories">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Categoria</th>
                            <th style="width:210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Categories!)
                        {
                            <tr>
                                <td>@category.Code</td>
                                <td>@category.Name</td>
                                <td>
                                    <a @onclick="@(() => ShowModalAsync(category.Id, true))" class="btn btn-sm btn-warning"><i class="bi bi-pencil" /> Editar</a>                     
                                    <HxButton Text="Borrar" Icon="BootstrapIcon.Trash" IconPlacement="ButtonIconPlacement.Start" Color="ThemeColor.Danger" Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(category))"/>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>

