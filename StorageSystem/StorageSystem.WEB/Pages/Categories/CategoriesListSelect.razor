<GenericList MyList="categories">
    <Body>
        @if (categories is not null)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th style="width:168px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in categories!)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td>
                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => OnSelectedCategoryChanged.InvokeAsync($"{category.Id},{category.Name}"))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No hay categorías disponibles. </p>
            <a href="/categories/create" class="btn btn-primary">Crear Categoría</a>
        }
    </Body>
</GenericList>






