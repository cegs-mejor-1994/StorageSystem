<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Codigo de Cliente:</label>
        <div>
            <HxInputText @bind-Value="@Client.Code"/>
            <ValidationMessage For="@(() => Client.Code)" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Identificcion de Cliente:</label>
        <div>
            <HxInputText @bind-Value="@Client.Nit" />
            <ValidationMessage For="@(() => Client.Nit)" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre de Cliente:</label>
        <div>
            <HxInputText @bind-Value="@Client.Name" />
            <ValidationMessage For="@(() => Client.Name)" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Direccion de Cliente:</label>
        <div>
            <HxInputText @bind-Value="@Client.Address" />
            <ValidationMessage For="@(() => Client.Address)" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Telefono de Cliente:</label>
        <div>
            <HxInputText @bind-Value="@Client.Phone" />
            <ValidationMessage For="@(() => Client.Phone)" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Ciudad de Cliente:</label>
        <div>
            <HxInputText @bind-Value="@Client.City" />
            <ValidationMessage For="@(() => Client.City)" />
        </div>
    </div>
    <HxSubmit Color="ThemeColor.Primary" Text="Guardar Cambios"/>
    <HxButton Color="ThemeColor.Success" Text="Regresar" OnClick="ReturnAction" />
</EditForm>





