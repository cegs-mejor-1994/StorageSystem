@page "/clients"
<PageTitle>Clientes</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Clientes
        <HxButton CssClass="float-end" Text="Nuevo Cliente" Color="ThemeColor.Primary" Size="ButtonSize.Small" Icon="BootstrapIcon.PlusSquare" IconPlacement="ButtonIconPlacement.Start" OnClick="@(() => ShowModalAsync())" />
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar cliente..." Callback="@FilterCallBack" />
        <GenericList MyList="Clients">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nit</th>
                            <th>Nombre</th>
                            <th>Direccion</th>
                            <th>Telefono</th>
                            <th>Ciudad</th>
                            <th style="width:210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Clients!)
                        {
                            <tr>
                                <td>@client.Code</td>
                                <td>@client.Nit</td>
                                <td>@client.Name</td>
                                <td>@client.Address</td>
                                <td>@client.Phone</td>
                                <td>@client.City</td>
                                <td>
                                    <a @onclick="@(() => ShowModalAsync(client.Id, true))" class="btn btn-sm btn-warning"><i class="bi bi-pencil" /> Editar</a>
                                    <HxButton Text="Borrar" Icon="BootstrapIcon.Trash" IconPlacement="ButtonIconPlacement.Start" Color="ThemeColor.Danger" Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(client))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>

