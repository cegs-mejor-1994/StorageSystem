@page "/inputInventories"

<PageTitle>Inventario de Materia Prima</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Inventario de Materia Prima
        <a class="btn btn-primary float-end" href="/inputInventories/create">Nuevo Inventario</a>
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar materia prima..." Callback="@FilterCallBack" />
        <GenericList MyList="InputInventories">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Codigo de Control</th>
                            <th>Materia prima</th>
                            <th>Cantidad</th>
                            <th>Lote</th>
                            <th>Fecha de Vencimiento</th>
                            <th>Proveedor</th>
                            <th style="width: 210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inputInventory in InputInventories!)
                        {                            
                            <tr>
                                <td>@inputInventory.ControlCode</td>
                                <td>@inputInventory.ProductName</td>
                                <td>@inputInventory.Amount @inputInventory.MeasurementUnitCode</td>
                                <td>@inputInventory.Batch</td>
                                <td>@inputInventory.MatutingDate</td>     
                                <td>@inputInventory.SupplierName</td>
                                <td>
                                    <a href="/inputInventories/edit/@inputInventory.ID" class="btn btn-warning"><i class="bi bi-pencil"/> Editar</a>
                                    
                                </td>
                            </tr>                            
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>



