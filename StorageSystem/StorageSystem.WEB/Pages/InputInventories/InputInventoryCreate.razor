@page "/inputInventories/create"
@using StorageSystem.WEB.Pages.MeasurementUnits
@using StorageSystem.WEB.Pages.Products
@using StorageSystem.WEB.Pages.RawMaterials

<PageTitle>Crear Inventario</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Crear Inventario de Materia Prima
        <a class="btn btn-success float-end" href="/inputInventories">Regresar</a>
    </HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="inputInventory" OnInvalidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-6">
                    <div class="md-3">
                        <label>Materia Prima:</label>
                        <InputText class="form-control" @bind-Value="productName" disabled />
                        <ValidationMessage For="@(() => inputInventory.ProductId)" />
                        <div>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productId">
                                Seleccionar
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Cantidad:</label>
                        <div class="row">
                            <div class="col-sm-8">
                                <InputNumber class="form-control" @bind-Value="inputInventory.Amount" step="0.001" />
                                <ValidationMessage For="@(() => inputInventory.Amount)" />
                            </div>
                            <div class="col-sm-4">      
                                @if (measurementUnits is not null)
                                {
                                    <HxSelect TItem="MeasurementUnit"
                                                TValue="int?"
                                                Data="measurementUnits"
                                                @bind-Value="measurementUnitId"
                                                TextSelector="@(measurementUnit => measurementUnit.Code)"
                                                ValueSelector="@(measurementUnit => measurementUnit.Id)"
                                                NullText="--- Seleccione Unidad de Medida ---"
                                                NullDataText="Cargando Unidades de Medida" />
                                }                                
                            </div>
                        </div>
                    </div>
                    @if (productRole == "Presentacion")
                    {
                        <div class="mb-3">
                            <label>Lote:</label>
                            <div>
                                <InputText class="form-control" @bind-Value="inputInventory.Batch" disabled/>
                                <ValidationMessage For="@(() => inputInventory.Batch)" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label>Lote:</label>
                            <div>
                                <InputText class="form-control" @bind-Value="inputInventory.Batch" />
                                <ValidationMessage For="@(() => inputInventory.Batch)" />
                            </div>
                        </div>
                    }
 
                </div>
                @if (productRole == "Presentacion")
                {
                    <div class="col-6">
                        <div class="mb-3">
                            <label>Fecha de Vencimiento:</label>
                            <div>
                                <InputDate class="form-control" @bind-Value="inputInventory.MatutingDate" disabled/>
                                <ValidationMessage For="@(() => inputInventory.MatutingDate)" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-6">
                        <div class="mb-3">
                            <label>Fecha de Vencimiento:</label>
                            <div>
                                <InputDate class="form-control" @bind-Value="inputInventory.MatutingDate" />
                                <ValidationMessage For="@(() => inputInventory.MatutingDate)" />
                            </div>
                        </div>
                    </div>
                }
                <button class="btn btn-primary form-control" type="submit">Guardar Cambios</button>                
            </div>
        </EditForm>
    </BodyTemplate>
</HxCard>

<div class="modal fade" id="productId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Materias Primas </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">                
                <RawMaterialsListSelect OnSelectedRawMaterialChanged="ClickProductCallBack"/>                            
            </div>
        </div>
    </div>
</div>