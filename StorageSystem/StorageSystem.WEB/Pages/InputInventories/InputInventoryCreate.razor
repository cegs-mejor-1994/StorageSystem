@page "/inputInventories/create"
@using StorageSystem.WEB.Pages.Suppliers
@using StorageSystem.WEB.Pages.RawMaterials

<h3>Crear Inventario</h3>
<EditForm Model="inputInventory">
    <DataAnnotationsValidator />
    <div class="row">
        <div class="col-6">
            <div class="md-3">
                <label>Materia Prima:</label>                              
                <InputText class="form-control" @bind-Value="rawMaterialName" disabled/>
                <InputNumber @bind-Value="inputInventory.RawMaterialId" />
                <ValidationMessage For="@(() => inputInventory.RawMaterialId)"/>
                <div>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#rawMaterialId">
                        Seleccionar
                    </button>
                </div>                
            </div>            
            <div class="mb-3">
                <label>Cantidad:</label>
                <div>
                    <InputText class="form-control" @bind-Value="inputInventory.Amount" />
                    <ValidationMessage For="@(() => inputInventory.Amount)" />
                </div>
            </div>
            <div class="mb-3">
                <label>Lote:</label>
                <div>
                    <InputText class="form-control" @bind-Value="inputInventory.Batch" />
                    <ValidationMessage For="@(() => inputInventory.Batch)" />
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="mb-3">
                <label>Proveedor:</label>                
                <InputText class="form-control" @bind-Value="supplierName" disabled />
                <ValidationMessage For="@(() => inputInventory.SupplierId)" />
                <InputNumber @bind-Value="inputInventory.SupplierId" />
                <div>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#supplierId">
                        Seleccionar
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label>Fecha de Vencimiento:</label>
                <div>
                    <InputDate class="form-control" @bind-Value="inputInventory.MatutingDate" />
                    <ValidationMessage For="@(() => inputInventory.MatutingDate)" />
                </div>
            </div>
        </div>

        <button class="btn btn-info" type="button" @onclick="@(() => AddAsync(inputInventory))">Agregar</button>
        <a href="/inputInventories" class="btn btn-success">Regresar</a>
    </div>
</EditForm>

<div class="modal fade" id="supplierId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Proveedores </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">                                
            <SuppliersListSelect OnSelectedSupplierChanged="ClickSupplierCallBack" />                                     
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rawMaterialId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Materias Primas </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">                
                <RawMaterialsListSelect OnSelectedRawMaterialChanged="ClickRawMaterialCallBack" />                            
            </div>
        </div>
    </div>
</div>

@if (inputInventories != null)
{    
    <GenericList MyList="inputInventories">
        <Body>         
            <div class="table-responsive-md">
                <table class="table table-striped overflow-auto">
                    <thead>
                        <tr>
                            <th>Materia Prima</th>
                            <th>Cantidad</th>
                            <th>Lote</th>
                            <th>Fecha de Vencimiento</th>
                            <th>Proveedor</th>
                            <th style="width: 168px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inputInventory in inputInventories!)
                        {
                            <tr>
                                <td>@inputInventory.RawMaterial!.Name</td>
                                <td>@inputInventory.Amount</td>
                                <td>@inputInventory.Batch</td>
                                <td>@inputInventory.MatutingDate</td>
                                <td>@inputInventory.Supplier!.Name</td>
                                <td>
                                    <button class="btn btn-danger" @onclick="@(() => DeleteAsync(inputInventory))">Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="text-center">
                    <button class="btn btn-primary form-control" type="button" @onclick="@(() => CreateAsync())">Guardar Cambios</button>
                </div>
            </div>
        </Body>
    </GenericList>
}