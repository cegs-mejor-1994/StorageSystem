@page "/measurementUnits"
<PageTitle>Unidades de Medida</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Unidades de Medida
        <a class="btn btn-primary float-end" href="/measurementUnits/create">Nueva Unidad de Medida</a>
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar Unidad de Medida..." Callback="@FilterCallBack" />
        <GenericList MyList="MeasurementUnits">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th style="width:210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var measurementUnit in MeasurementUnits!)
                        {
                            <tr>
                                <td>@measurementUnit.Code</td>
                                <td>@measurementUnit.Name</td>
                                <td>@measurementUnit.PhysicalState</td>
                                <td>
                                    <a href="/measurementUnits/edit/@measurementUnit.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil" /> Editar</a>
                                    <HxButton Text="Borrar" Icon="BootstrapIcon.Trash" IconPlacement="ButtonIconPlacement.Start" Color="ThemeColor.Danger" Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(measurementUnit))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>

