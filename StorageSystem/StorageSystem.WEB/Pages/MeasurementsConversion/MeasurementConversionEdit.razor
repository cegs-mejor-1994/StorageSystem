@page "/measurementConversions/edit/{Id:int}"

@if (measurementConversion is null)
{
    <Loading/>
}
else
{
    <HxCard>
        <HeaderTemplate>
            <HxIcon Icon="@BootstrapIcon.ArrowsAngleContract" /> Edita Factor de Conversion
            <a class="btn btn-success float-end" href="/measurementConversions">Regresar</a>
        </HeaderTemplate>
        <BodyTemplate>
            <EditForm Model="measurementConversion" OnValidSubmit="EditAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <div class="mb-3">
                        <label class="form-label">Unidad Origen a Convertir</label>
                        <div>
                            <HxInputText @bind-Value="@fromUnitCode" Decimals="4" Enabled="false"/>
                            <ValidationMessage For="@(() => measurementConversion.FromUnitId)" />
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="mb-3">
                        <label class="form-label">Unidad Destino a Convertir</label>
                        <div>
                            <HxInputText @bind-Value="@toUnitCode" Decimals="4" Enabled="false"/>
                            <ValidationMessage For="@(() => measurementConversion.ToUnitId)" />
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Factor</label>
                    <div>
                        <HxInputNumber @bind-Value="@measurementConversion.Factor" Decimals="4" />
                        <ValidationMessage For="@(() => measurementConversion.Factor)" />
                    </div>
                </div>
                <div class="d-grid gap-2 d-md-block">
                    <HxSubmit Color="ThemeColor.Primary" Text="Guardar Cambios" />
                </div>
            </EditForm>            
        </BodyTemplate>
    </HxCard>
}






