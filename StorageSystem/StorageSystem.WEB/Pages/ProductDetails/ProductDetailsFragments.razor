@page "/formReferences/details/{ProductId:int}"

<PageTitle>Editar Formula</PageTitle>
<HxCard>
    <HeaderTemplate>
        <h3 class="text-center">@product.Name</h3>
        <div class="row g-1 align-items-center">
            <div class="col-12 col-sm-8">
                <InputText class="form-control" @bind-Value="appearanceReferenceName" disabled placeholder="Referencia" />
            </div>
            <div class="col-12 col-sm-4">
                <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#appearanceReferenceId">
                    Seleccionar Referencia
                </button>
            </div>
        </div>
        @if (referenceSelected)
        {
            <div class="row g-1 align-items-center">
                <div class="col-12 col-sm-12">
                    <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#rawMaterialId">
                        Seleccionar Materia Prima
                    </button>
                </div>
            </div>
        }
        <div class="row g-1 align-items-center mt-1">
            <div class="col-12 col-sm-4">
                <a href="/recipes" class="btn btn-success w-100">Regresar</a>
            </div>
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        @if (ProductsDetails != null)
        {
            <GenericList MyList="ProductsDetails">
                <Body>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Referencia</th>
                                <th>Materia prima</th>
                                <th style="width: 210px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var productsDetail in ProductsDetails!)
                            {
                                <tr>
                                    <td>@productsDetail.AppearanceReference!.Reference!.Name @productsDetail.AppearanceReference.Reference.MeasurementUnit!.Code</td>
                                    <td>@productsDetail.RawMaterial!.Name</td>                                  
                                    <td>
                                        <HxButton Text="Borrar" Icon="BootstrapIcon.Trash" IconPlacement="ButtonIconPlacement.Start" Color="ThemeColor.Danger" Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(productsDetail))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Body>
            </GenericList>
        }
    </BodyTemplate>
</HxCard>


<div class="modal fade" id="rawMaterialId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Materias Primas </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">
                <GenericList MyList="rawMaterials">
                    <Body>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th style="width:168px">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rawMaterial in rawMaterials!)
                                {
                                    var exists = ProductsDetails?.Any(r => r.RawMaterialId == rawMaterial.Id && r.ProductId == ProductId) ?? false;
                                    @if (!exists)
                                    {
                                        <tr>
                                            <td>@rawMaterial.Name</td>
                                            <td>
                                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => ClickRawMaterialCallBack($"{rawMaterial.Id}"))" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </Body>
                </GenericList>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="appearanceReferenceId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Referencias</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">
                <GenericList MyList="appearanceReferences">
                    <Body>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th style="width:168px">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appearanceReference in appearanceReferences!)
                                {
                                    var exists = ProductsDetails?.Any(r => r.AppearanceReferenceId == appearanceReference.Id && r.ProductId == ProductId) ?? false;
                                    @if (!exists)
                                    {
                                        <tr>
                                            <td>@appearanceReference.Reference!.Name @appearanceReference.Reference.MeasurementUnit!.Code</td>
                                            <td>
                                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => ClickAppearanceReferenceCallBack($"{appearanceReference.Id}, {appearanceReference.Reference.Name},{appearanceReference.Reference.MeasurementUnit.Code}"))" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </Body>
                </GenericList>
            </div>
        </div>
    </div>
</div>