@page "/productDetails"
<PageTitle>Asignacion de Etiquetas</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Asignacion de Etiquetas
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar Producto Asignado..." Callback="@FilterCallBack" />
        <GenericList MyList="Products">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th style="width: 210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Products!)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>
                                    <a href="/productDetails/details/@product.Id" class="btn btn-warning"><i class="bi bi-pencil" /> Detalles</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>
















