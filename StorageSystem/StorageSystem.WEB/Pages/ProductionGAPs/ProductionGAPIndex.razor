@page "/productionsgaps"
<PageTitle>Procesos</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Procesos
        <a class="btn btn-primary float-end" href="/productionsgaps/create">Nuevo Proceso</a>
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar formula..." Callback="@FilterCallBack" />
        <GenericList MyList="ProductionGaps">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Cantidad proceso</th>
                            <th>Lote / Vence</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var productionGap in ProductionGaps!)
                        {
                            <tr>
                                <td>@productionGap.Recipe!.Product!.Name</td>
                                <td>@productionGap.Amount</td>
                                <td>@productionGap.RegisterDate</td>  
                                <td>
                                    <a href="/products/details/@productionGap.Id" class="btn btn-warning"><i class="bi bi-pencil" /> Detalles</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>









