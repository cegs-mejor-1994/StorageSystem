@page "/products"
<PageTitle>Productos</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Productos
        <a class="btn btn-primary float-end" href="/products/create">Nuevo Producto</a>
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar producto..." Callback="@FilterCallBack" />
        <GenericList MyList="Products">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Rol</th>
                            <th style="width: 210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Products!)
                        {
                            <tr>
                                <td>@product.Code</td>
                                <td>@product.Name</td>
                                <td>@product.PhysicalState</td>
                                <td>@product.Role</td>
                                <td>
                                    <a href="/products/edit/@product.Id" class="btn btn-warning"><i class="bi bi-pencil" /> Editar</a>
                                    <HxButton Color="ThemeColor.Danger" Text="Borrar" OnClick="@(() => DeleteAsync(product))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>



