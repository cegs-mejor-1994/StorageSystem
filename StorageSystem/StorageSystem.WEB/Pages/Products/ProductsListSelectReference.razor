<GenericList MyList="products">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th style="width:168px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products!.Where(p => p.Role.ToString() != "MateriaPrima" && p.Role.ToString() != "Presentacion"))
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>
                            <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => OnSelectedProductChanged.InvokeAsync($"{product.Id},{product.Name},{product.PhysicalState}"))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>





