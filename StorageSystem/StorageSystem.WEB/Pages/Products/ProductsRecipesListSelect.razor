<GenericList MyList="products">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th style="width:168px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products!)
                {
                    var existeFormula = recipes!.Any(r => r.ProductId == product.Id);
                    <tr>
                        @if (!existeFormula)
                        {
                            <td>@product.Name</td>
                            <td>
                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => OnSelectedProductRecipeChanged.InvokeAsync($"{product.Id},{product.Name}"))" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>





