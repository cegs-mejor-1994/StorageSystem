<GenericList MyList="products">
    <Body>
        @if (products is not null)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th style="width:210px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in products!)
                    {

                        <tr>
                            <td>@product.Name</td>
                            <td>
                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => OnSelectedRawMaterialChanged.InvokeAsync($"{product.Id},{product.Name},{product.PhysicalState},{product.Role}"))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else 
        {
            <p>No hay materias primas disponibles. </p>
            <a href="/products/create" class="btn btn-primary">Crear Materia Prima</a>
        }
    </Body>
</GenericList>

