<GenericList MyList="rawMaterials">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th style="width:168px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rawMaterial in rawMaterials!)
                {
                    <tr>
                        <td>@rawMaterial.Name</td>
                        <td>
                            <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => OnSelectedRawMaterialChanged.InvokeAsync($"{rawMaterial.Id},{rawMaterial.Name}"))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

