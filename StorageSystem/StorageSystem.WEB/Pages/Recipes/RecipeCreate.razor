@page "/recipes/create"
@using StorageSystem.WEB.Pages.Products
@using StorageSystem.WEB.Pages.RawMaterials

<PageTitle>Crear Formula</PageTitle>
<HxCard>
    <HeaderTemplate>
        <EditForm Model="recipe">
            <DataAnnotationsValidator />
            <div class="row g-1 align-items-center">
                <div class="col-12 col-sm-8">
                    <InputText class="form-control" @bind-Value="productName" disabled placeholder="Producto" />
                    <ValidationMessage For="@(() => recipe.ProductId)" />
                </div>
                <div class="col-12 col-sm-4">
                    <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#productId" disabled="@(isProductButton)">
                        Seleccionar
                    </button>
                </div>
            </div>
            <div class="row g-1 align-items-center">
                <div class="col-12 col-sm-8">
                    <InputText class="form-control" @bind-Value="rawMaterialName" disabled placeholder="Materia Prima" />
                    <ValidationMessage For="@(() => recipe.RawMaterialId)" />
                </div>
                <div class="col-12 col-sm-4">
                    <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#rawMaterialId">
                        Seleccionar
                    </button>
                </div>
            </div>
            <div class="row g-1 align-items-center">
                <div class="col-12 col-sm-4">
                    <InputText class="form-control" @bind-Value="recipe.Amount" placeholder="Cantidad" /> @rawMaterialCodeMeasurementUnit
                    <ValidationMessage For="@(() => recipe.Amount)" />
                </div>
                <div class="col-12 col-sm-4">
                    <button class="btn btn-primary w-100" type="button" @onclick="@(() => CreateAsync())">Guardar Cambios</button>
                </div>
                <div class="col-12 col-sm-4">
                    <a href="/recipes" class="btn btn-success w-100">Regresar</a>
                </div>
            </div>
        </EditForm>
    </HeaderTemplate>
    <BodyTemplate>
        @if (Recipes != null)
        {
            <GenericList MyList="Recipes">
                <Body>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Materia prima</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recipe in Recipes!)
                            {
                                <tr>
                                    <td>@recipe.RawMaterial!.Name</td>
                                    <td>@recipe.Amount @recipe.RawMaterial.MeasurementUnit!.Code</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Body>
            </GenericList>
        }
    </BodyTemplate>        
</HxCard>

<div class="modal fade" id="productId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Productos </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">
                <ProductsRecipesListSelect OnSelectedProductRecipeChanged="ClickProductCallBack" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rawMaterialId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Materias Primas </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">
                <GenericList MyList="rawMaterials">
                    <Body>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th style="width:168px">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rawMaterial in rawMaterials!)
                                {
                                    var exists = Recipes?.Any(r => r.RawMaterialId == rawMaterial.Id) ?? false;
                                    @if (!exists)
                                    {
                                        <tr>
                                            <td>@rawMaterial.Name</td>
                                            <td>
                                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => ClickRawMaterialCallBack($"{rawMaterial.Id},{rawMaterial.Name},{rawMaterial.MeasurementUnit!.Code}"))" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </Body>
                </GenericList>
            </div>
        </div>
    </div>
</div>

