@page "/recipes/details/{ProductId:int}"
@using StorageSystem.WEB.Pages.RawMaterials

<PageTitle>Editar Formula</PageTitle>
<HxCard>
    <HeaderTemplate>
        <h3 class="text-center">@GetProductName()</h3>
        <div class="row g-1 align-items-center">
            <div class="col-12 col-sm-8">
                <InputText class="form-control" @bind-Value="rawMaterialName" disabled placeholder="Materia Prima" />                
            </div>
            <div class="col-12 col-sm-4">
                <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#rawMaterialId">
                    Seleccionar
                </button>
            </div>
        </div>
        <div class="row g-1 align-items-center mt-1">
            <div class="col-12 col-sm-4 d-flex align-items-center">
                <label class="me-2 mb-0">Cantidad @rawMaterialCodeMeasurementUnit</label>
                <InputText class="form-control" style="max-width: 200px" @bind-Value="recipe.Amount" placeholder="Cantidad" />                
            </div>
            <div class="col-12 col-sm-4">
                <button class="btn btn-primary w-100" type="button" onclick="@(() => CreateAsync())">Guardar Cambios</button>
            </div>
            <div class="col-12 col-sm-4">
                <a href="/recipes" class="btn btn-success w-100">Regresar</a>
            </div>
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        @if (Recipes != null)
        {
            <GenericList MyList="Recipes">
                <Body>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Materia prima</th>
                                <th>Cantidad</th>
                                <th style="width: 210px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recipe in Recipes!)
                            {
                                <tr>
                                    <td>@recipe.RawMaterial!.Name</td>
                                    <td>@recipe.Amount @recipe.RawMaterial.MeasurementUnit!.Code</td>
                                    <td>
                                        <HxButton Text="Editar" Color="ThemeColor.Warning" IconPlacement="ButtonIconPlacement.Start" Icon="BootstrapIcon.Pencil" Size="ButtonSize.Small" OnClick="@(() => ShowModalAsync(recipe.Id))" />
                                        <HxButton Text="Borrar" Icon="BootstrapIcon.Trash" IconPlacement="ButtonIconPlacement.Start" Color="ThemeColor.Danger" Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(recipe))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Body>
            </GenericList>
        }
    </BodyTemplate>
</HxCard>

<div class="modal fade" id="rawMaterialId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Materias Primas </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">
                <GenericList MyList="rawMaterials">
                    <Body>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th style="width:168px">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rawMaterial in rawMaterials!)
                                {
                                    var exists = Recipes?.Any(r => r.RawMaterialId == rawMaterial.Id) ?? false;
                                    @if (!exists)
                                    {
                                        <tr>
                                            <td>@rawMaterial.Name</td>
                                            <td>
                                                <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => ClickRawMaterialCallBack($"{rawMaterial.Id},{rawMaterial.Name},{rawMaterial.MeasurementUnit!.Code}"))" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </Body>
                </GenericList>
            </div>
        </div>
    </div>
</div>