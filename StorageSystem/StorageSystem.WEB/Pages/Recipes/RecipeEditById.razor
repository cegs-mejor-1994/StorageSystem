@page "/recipes/RawMaterialedit/{Id:int}"

@if (Recipe == null)
{
    <Loading />
} 
else 
{ 
    <div class="row g-1 align-items-center">
        <div class="col-12 col-sm-12">
            <HxInputText @bind-Value="RawMaterial!.Name" Enabled="false"/>
        </div>
        <div class="col-12 col-sm-12 d-flex mt-2">
            @if (RawMaterial != null)
            {
                <label class="form-label me-2 mb-0">Cantidad @RawMaterial.MeasurementUnit!.Code</label>                
            }            
            <div>
                <HxInputText style="max-width: 200px" @bind-Value="Recipe!.Amount" />   
            </div>
        </div>
        <div class="d-grid gap-2 d-md-block">
            <HxButton Color="ThemeColor.Primary" Text="Guardar Cambios" OnClick="@(() => EditAsync())" />
        </div>
    </div>
}


