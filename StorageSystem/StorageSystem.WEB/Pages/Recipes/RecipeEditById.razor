@page "/recipes/RawMaterialedit/{Id:int}"

@if (RecipeDetail == null)
{
    <Loading />
} 
else 
{     
    <div class="row g-1 align-items-center">
        <div class="col-12 col-sm-12">
            @if(Product != null)
            {
                <HxInputText @bind-Value="Product!.Name" Enabled="false" />
            }
        </div>
        <div class="col-12 col-sm-12 d-flex mt-2">
            @if (MeasurementUnit != null)
            {
                <label class="form-label me-2 mb-0">Cantidad @MeasurementUnit!.Code</label>                
            }            
            <div>
                <InputNumber style="max-width: 200px" @bind-Value="RecipeDetail!.Amount" />   
            </div>
        </div>
        <div class="d-grid gap-2 d-md-block">
            <HxButton Color="ThemeColor.Primary" Text="Guardar Cambios" OnClick="@(() => EditAsync())" />
        </div>
    </div>    
}


