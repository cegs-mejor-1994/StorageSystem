@page "/recipes"
<PageTitle>Formulas</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Formulas
        <a class="btn btn-primary float-end" href="/recipes/create">Nueva Formula</a>
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar formula..." Callback="@FilterCallBack" />
        <GenericList MyList="Recipes">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>                            
                            <th>Nombre</th>
                            <th style="width: 210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recipe in Recipes!)
                        {
                            <tr>                                
                                <td>@recipe.Product!.Name</td>
                                <td>
                                    <a href="/recipes/edit/@recipe.ProductId" class="btn btn-success"><i class="bi bi-pencil"/> Detalles</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>

