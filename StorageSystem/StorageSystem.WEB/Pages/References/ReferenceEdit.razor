@page "/references/edit/{Id:int}"

<h3>Editar Referencia</h3>

@if (reference is null)
{
    <Loading />
}
else
{   
    <EditForm Model="reference">
    <DataAnnotationsValidator />
    <div class="row">
        <div class="col-6">
            <div class="mb-3">                
                <div>
                    <HxInputText @bind-Value="@reference.Name" Label="Nombre de referencia" />
                    <ValidationMessage For="@(() => reference.Name)" />
                </div>
            </div>
            <div class="mb-3">           
                <label>Unidad de Medida</label>
                <div>
                    <HxInputText @bind-Value="measurementUnitName" disabled/>
                    <ValidationMessage For="@(() => reference.MeasurementUnitId)" />    
                </div>
            </div>
            <HxButton Text="Guardar Cambios" Color="ThemeColor.Primary" OnClick="@(() => EditAsync())" />            
        </div>        
    </div>
</EditForm>
}


