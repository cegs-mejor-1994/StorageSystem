<GenericList MyList="references">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre de Referencia</th>
                    <th style="width:168px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reference in references!)
                {
                    <tr>
                        <td>@reference.MeasurementUnit?.Name</td>
                        <td>
                            <HxButton Color="ThemeColor.Secondary" data-bs-dismiss="modal" Text="Seleccionar" OnClick="@(() => OnSelectedReferenceChanged.InvokeAsync($"{reference.Id},{reference.MeasurementUnit?.Name}"))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>
