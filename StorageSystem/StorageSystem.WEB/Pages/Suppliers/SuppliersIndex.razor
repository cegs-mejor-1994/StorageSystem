@page "/suppliers"
<PageTitle>Proveedores</PageTitle>
<HxCard>
    <HeaderTemplate>
        <HxIcon Icon="@BootstrapIcon.ListCheck" /> Proveedores
        <a class="btn btn-primary float-end" href="/suppliers/create">Crear Proveedor</a>
    </HeaderTemplate>
    <BodyTemplate>
        <Filter PlaceHolder="Buscar Proveedor..." Callback="@FilterCallBack" />
        <GenericList MyList="Suppliers">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>                            
                            <th>Nit</th>
                            <th>Nombre</th>
                            <th>Direccion</th>
                            <th>Telefono</th>
                            <th>Ciudad</th>
                            <th style="width:210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Suppliers!)
                        {
                            <tr>                                
                                <td>@supplier.Nit</td>
                                <td>@supplier.Name</td>
                                <td>@supplier.Address</td>
                                <td>@supplier.Phone</td>
                                <td>@supplier.City</td>
                                <td>
                                    <a class="btn btn-warning" href="/suppliers/edit/@supplier.Id"><i class="bi bi-pencil" /> Editar</a>
                                    <HxButton Text="Borrar" Icon="BootstrapIcon.Trash" IconPlacement="ButtonIconPlacement.Start" Color="ThemeColor.Danger" Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(supplier))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </BodyTemplate>
</HxCard>



