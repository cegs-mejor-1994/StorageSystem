@page "/suppliers"
<PageTitle>Proveedores</PageTitle>
<div class="card">
    <div class="card-header">
        <span>
            <i class="bi bi-list-check"></i> Proveedores
            <a @onclick="@(() => ShowModalAsync())" class="btn btn-primary btn-sm float-end"><i class="bi bi-plus-square" /> Nuevo Proveedor</a>
        </span>
    </div>
    <div class="card-body">
        <Filter PlaceHolder="Buscar proveedor..." Callback="@FilterCallBack" />
        <GenericList MyList="Suppliers">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nit</th>
                            <th>Nombre</th>
                            <th>Direccion</th>
                            <th>Telefono</th>
                            <th>Ciudad</th>
                            <th style="width:210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Suppliers!)
                        {
                            <tr>
                                <td>@supplier.Nit</td>
                                <td>@supplier.Name</td>
                                <td>@supplier.Address</td>
                                <td>@supplier.Phone</td>
                                <td>@supplier.City</td>
                                <td>
                                    <a @onclick="@(() => ShowModalAsync(supplier.Id, true))" class="btn btn-sm btn-warning"><i class="bi bi-pencil" /> Editar</a>
                                    <button @onclick="() => DeleteAsync(supplier)" class="btn btn-sm btn-danger"><i class="bi bi-trash" /> Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </div>
</div>

