@page "/suppliers"
@using Havit.Blazor.Components.Web

<h3>Proveedores</h3>
<div class="mb-3">
    <a class="btn btn-primary btn-sm float-end" @onclick="@(() => ShowModalAsync())">Nuevo Proveedor</a>
    <HxButton Text="Basic Button" Color="ThemeColor.Primary" style="border-radius: 50px" CssClass="float-end"/>
</div>
<GenericList MyList="Suppliers">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nit</th>
                    <th>Nombre</th>
                    <th>Direccion</th>
                    <th>Telefono</th>
                    <th>Ciudad</th>
                    <th style="width:168px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Suppliers!)
                {
                    <tr>
                        <td>@supplier.Nit</td>
                        <td>@supplier.Name</td>
                        <td>@supplier.Address</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.City</td>
                        <td>
                            <a @onclick="@(() => ShowModalAsync(supplier.Id, true))" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick="@(() => DeleteAsync(supplier))">Borrar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>


