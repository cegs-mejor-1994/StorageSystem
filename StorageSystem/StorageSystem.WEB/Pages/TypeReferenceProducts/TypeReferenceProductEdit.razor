@page "/typeReferenceProducts/edit/{Id:int}"

<h3>Editar Producto de Referencia</h3>

@if (typeReferenceProduct is null)
{
    <Loading />
}
else
{
    <EditForm Model="typeReferenceProduct" OnValidSubmit="EditAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label>Nombre de Producto de Referencia:</label>
            <div>
                <InputText class="form-control" @bind-Value="@typeReferenceProduct.Name" />
                <ValidationMessage For="@(() => typeReferenceProduct.Name)" />
            </div>
        </div>
        <button class="btn btn-primary" type="submit">Guardar Cambios</button>
    </EditForm>

}


