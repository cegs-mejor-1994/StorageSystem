@page "/typeReferenceProducts"

<PageTitle>Referencias de Productos</PageTitle>
<div class="card">
    <div class="card-header">
        <span>
            <i class="bi bi-list-check"></i> Referencias de Productos
            <a @onclick="@(() => ShowModalAsync())" class="btn btn-primary btn-sm float-end"><i class="bi bi-plus-square" /> Nueva Referencia de Producto</a>
        </span>
    </div>
    <div class="card-body">
        <Filter PlaceHolder="Buscar Referencia de Producto..." Callback="@FilterCallBack" />
        <GenericList MyList="TypeReferenceProducts">
            <Body>
                <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" RecordsNumber="SelectedRecordsNumberAsync" />
                <table class="table table-striped">
                    <thead>
                        <tr>                            
                            <th>Nombre</th>
                            <th style="width:210px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var typeReferenceProduct in TypeReferenceProducts!)
                        {
                            <tr>
                                <td>@typeReferenceProduct.Name</td>
                                <td>
                                    <a @onclick="@(() => ShowModalAsync(typeReferenceProduct.Id, true))" class="btn btn-sm btn-warning"><i class="bi bi-pencil" /> Editar</a>
                                    <button @onclick="() => DeleteAsync(typeReferenceProduct)" class="btn btn-sm btn-danger"><i class="bi bi-trash" /> Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </div>
</div>




