<div class="mb-2" style="display: flex; flex-wrap: wrap; align-items: center;">
    <HxInputText @bind-Value="TextToFilter" Placeholder="@PlaceHolder" style="width: 400px;"/>
    <HxButton Text="Filtrar" Size="ButtonSize.Small" Color="ThemeColor.Primary" Icon="BootstrapIcon.Funnel" CssClass="mx-1" IconPlacement="ButtonIconPlacement.Start" OnClick="@(() => ApplyFilterAsync())" Outline="true"/>
    <HxButton Text="Limpiar" Size="ButtonSize.Small" Color="ThemeColor.Danger" Icon="BootstrapIcon.XCircle" IconPlacement="ButtonIconPlacement.Start" OnClick="@(() => CleanFilterAsync())" Outline="true"/>
</div>
